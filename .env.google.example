# Google OAuth Configuration (Optional)
# Untuk mengaktifkan Google Login:
# 1. Install Laravel Socialite: composer require laravel/socialite
# 2. Buat OAuth credentials di Google Cloud Console
# 3. Set environment variables di bawah ini
# 4. Uncomment baris di config/services.php

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
